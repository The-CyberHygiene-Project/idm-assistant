[Unit]
Description=CHP first boot (identity server): DNS, step-ca, Kanidm, collector token, SSH CA
After=chp-firstboot-common.service network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/chp/firstboot/server.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/chp/server-firstboot
RemainAfterExit=yes
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
