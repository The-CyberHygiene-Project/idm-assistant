[Unit]
Description=CHP: nightly NextCloud tag check and share canary (chp-site documents check; result for check 81)
ConditionPathExists=/etc/chp/documents.conf
After=postgresql.service httpd.service php-fpm.service
[Service]
UMask=0077
Type=oneshot
ExecStart=/usr/bin/chp-site documents check
# runs after success, failure, a timeout or a kill: the canary account is never left enabled with a token
ExecStopPost=/usr/bin/chp-site documents canary-off
TimeoutStartSec=30min
Nice=10
