#!/bin/bash
# CyberHygiene Project Lab Installer — based on Rocky Linux 9.
# Not an official Rocky Linux product.
# Rocky Linux is a trademark of the Rocky Enterprise Software Foundation.
# chp-nextcloud-backup [backup|restore DIR|keep-days] (root; chp-nextcloud-backup.timer nightly):
#   backup     maintenance mode on -> pg_dump (peer auth) + rsync of the data directory and /etc/nextcloud into
#              /backup/nextcloud/<UTC stamp>/ -> maintenance off; keeps DOCUMENTS_BACKUP_DAYS days (from
#              /etc/chp/documents.conf, default 14); MANIFEST with sha256. The copies hold CUI: mode 0700, root only.
#              Only a directory with a MANIFEST is a copy (MANIFEST is written last, via rename): a directory left
#              without one by a killed run (SIGKILL skips the cleanup trap) is neither the --link-dest base nor
#              counted toward MIN_KEEP, and is deleted at the start of the next run.
#   restore    the reverse onto a reset server (nextcloud-chp installed, database empty or absent); verifies MANIFEST
#   keep-days  print the retention in force
set -Eeuo pipefail
CONF=${CHP_DOCUMENTS_CONF:-/etc/chp/documents.conf}
B=${CHP_NC_BACKUP:-/backup/nextcloud}; D=${CHP_NC_DATA:-/data/nextcloud/data}; OCC=${CHP_OCC:-/usr/bin/occ}
SD=${CHP_DOCS_STATE:-/var/lib/chp/documents}; MIN_KEEP=2
keep_days() {
  local v; v=$(sed -n 's/^DOCUMENTS_BACKUP_DAYS=//p' "$CONF" 2>/dev/null | head -1)
  case $v in ''|*[!0-9]*|0) v=14 ;; esac
  echo "$v"
}
KEEP=$(keep_days)
occ() { "$OCC" "$@"; }
log() { logger -t chp-nextcloud-backup -- "$*" 2>/dev/null || :; echo "$*"; }
status() { install -d -m 0700 "$SD"; printf '%s %s %s\n' "$1" "$(date +%s)" "$2" > "$SD/backup.status"; }
# only backup directories (UTC stamp names, which sort oldest first); anything else under $B is never touched
dirs() { find "$B" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | grep -E '/[0-9]{8}T[0-9]{6}Z$' | sort; return 0; }
stamps() { local d; for d in $(dirs); do [ -s "$d/MANIFEST" ] && echo "$d"; done; return 0; }   # complete copies only
partials() { local d; for d in $(dirs); do [ -s "$d/MANIFEST" ] || echo "$d"; done; return 0; }
free_kb() { df -Pk "$B" | awk 'NR==2{print $4}'; }
case ${1:-backup} in
  keep-days) echo "$KEEP" ;;
  backup)
    install -d -m 0700 "$B"
    { install -d -m 0700 "$SD" && exec 9> "$SD/backup.lock"; } 2>/dev/null \
      || { log "backup FAILED: cannot open the lock $SD/backup.lock"; status FAILED "cannot open the lock $SD/backup.lock"; exit 75; }
    flock -n 9 || { log "backup not started: another backup is running (it records the status)"; exit 75; }
    for d in $(partials); do log "deleting the incomplete copy $d (no MANIFEST: an earlier run was killed)"; rm -rf "$d"; done
    prev=$(stamps | tail -1)
    # Space first: a full /backup must not stop backups forever. Each night is an rsync --link-dest incremental plus a
    # new database dump, but we require room for a whole copy of the last one; prune the oldest (keeping at least
    # MIN_KEEP) until it fits, else fail loudly (status FAILED -> monitor check 77 ALERT). du -sk counts the last
    # copy's hardlinked (unchanged) files in full, so it overestimates what an incremental needs: conservative, it
    # can only fail loudly too early, never run out of space unannounced.
    if [ -n "$prev" ]; then
      need=$(du -sk "$prev" | cut -f1)
      while [ "$(free_kb)" -lt "$need" ] && [ "$(stamps | wc -l)" -gt "$MIN_KEEP" ]; do
        old=$(stamps | head -1); log "low space on /backup: pruning the oldest copy $old"; rm -rf "$old"
      done
      if [ "$(free_kb)" -lt "$need" ]; then
        log "backup FAILED: not enough space in $B ($(free_kb) kB free, last copy $need kB, only $(stamps | wc -l) copies kept)"
        status FAILED "not enough space in $B ($(free_kb) kB free, last copy $need kB)"; exit 75
      fi
    fi
    t=$(date -u +%Y%m%dT%H%M%SZ); o=$B/$t
    trap 'rc=$?; occ maintenance:mode --off >/dev/null 2>&1 || true; if [ $rc -ne 0 ]; then rm -rf "$o"; status FAILED "backup $t exited $rc"; fi' EXIT
    install -d -m 0700 "$o"
    occ maintenance:mode --on >/dev/null
    runuser -u postgres -- pg_dump -Fc nextcloud > "$o/nextcloud.pgdump"
    link=(); [ -n "$prev" ] && [ -d "$prev/data" ] && link=(--link-dest="$prev/data")
    rsync -aHAX --numeric-ids ${link[@]+"${link[@]}"} "$D/" "$o/data/"
    rsync -aHAX --numeric-ids /etc/nextcloud/ "$o/etc-nextcloud/"
    occ maintenance:mode --off >/dev/null
    (cd "$o" && find . -type f ! -name MANIFEST ! -name MANIFEST.tmp -print0 | sort -z | xargs -0 sha256sum > MANIFEST.tmp && mv MANIFEST.tmp MANIFEST)
    # retention: older than KEEP days go, but never below MIN_KEEP copies
    n=$(stamps | wc -l)
    for d in $(stamps); do
      [ "$n" -gt "$MIN_KEEP" ] || break
      if [ -n "$(find "$d" -maxdepth 0 -mtime +"$KEEP")" ]; then rm -rf "$d"; n=$((n - 1)); fi
    done
    trap - EXIT; status OK "backup $t"
    log "backup $t: $(du -sh "$o" | cut -f1), $(wc -l < "$o/MANIFEST") files, keeping $KEEP days (at least $MIN_KEEP copies)" ;;
  restore)
    o=${2:?restore DIR}; [ -s "$o/MANIFEST" ] || { echo "no MANIFEST in $o"; exit 1; }
    (cd "$o" && sha256sum --quiet -c MANIFEST) || { echo "MANIFEST check FAILED: not restoring"; exit 1; }
    systemctl stop httpd php-fpm nextcloud-cron.timer
    runuser -u postgres -- psql -qc "DROP DATABASE IF EXISTS nextcloud" -c "CREATE DATABASE nextcloud OWNER apache TEMPLATE template0 ENCODING 'UTF8'"
    runuser -u postgres -- pg_restore -d nextcloud --no-owner --role=apache < "$o/nextcloud.pgdump"   # stdin: the dir is root-only
    install -d -m 0750 -o apache -g apache /data/nextcloud "$D"
    rsync -aHAX --numeric-ids --delete "$o/data/" "$D/"
    rsync -aHAX --numeric-ids "$o/etc-nextcloud/" /etc/nextcloud/
    restorecon -R /data/nextcloud /etc/nextcloud
    systemctl start php-fpm httpd nextcloud-cron.timer
    occ maintenance:mode --off >/dev/null; occ maintenance:data-fingerprint >/dev/null
    log "restored from $o" ;;
  *) echo "usage: chp-nextcloud-backup [backup|restore DIR|keep-days]"; exit 2 ;;
esac
