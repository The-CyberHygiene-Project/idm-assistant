# Managed by chp-security (review spec §3): each host's status record log, read by the Wazuh agent.
# copytruncate: the agent keeps its file open and follows the truncation; records are also kept on the manager.
/var/log/chp-review.json {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
