# profile.ini: the values your SSP and POA&M are filled from (chp-site docs). Copy this file to the site stick's top
# level, next to site.conf, as profile.ini, then replace every example value with your own. Leave a line out, or leave
# it blank, and that value stays visible as {{placeholder}} in the documents and is listed in fill-report.md.
#
# NEVER put passwords, keys or tokens in this file. The same names are used by Automated_Compliance.
# Every example below is made up.

[organization]
legal_name = Example Manufacturing LLC
dba = Example Parts
# city and state only
location = Springfield, ST
uei = EXAMPLEUEI00
cage = EX000
owner_email = owner@example.test

[roles]
system_owner = Alex Example, Owner
# The ISSO comes from site.conf (ISSO_NAME) unless you set it here.
security_officer = Alex Example, Owner
administrator = Sam Sample

[system]
name = Example Parts CUI Enclave
purpose = Stores and processes CUI received under defense subcontracts.
status = Operational
appliance_version = 0.2.0

# One section per system, Automated_Compliance's form. in_boundary = yes puts it in the boundary list.
[system.srv1]
kind = identity server
in_boundary = yes
operating_system = Rocky Linux 9
administered_by = Sam Sample

[system.ws1]
kind = engineering workstation
in_boundary = yes
operating_system = Rocky Linux 9

[scope]
cui_types =
    CUI//SP-CTI (controlled technical information)
boundary_note = The boundary is the identity server and the workstations on the site network.

# One section per contract, Automated_Compliance's form.
[contract.1]
label = Example Prime Corp purchase order
vehicle = purchase order
clauses = DFARS 252.204-7012
required_revision = Rev 2

[document]
version = 1.0
date = 10/25/2026
author = Alex Example
classification = CUI
status = Draft
next_review = 01/25/2027

[poam]
reference = Example POA&M v1.0

[policies]
list =
    Access Control Policy v1.0
    Incident Response Plan v1.0

# Your decisions. The appliance ENFORCES lockout after 3 failed attempts (locked until an administrator unlocks the
# account, lockout_minutes = 0) and a 12-character minimum for local passwords; change those only if you change
# the hosts too.
[decision]
review_cycle_months = 3
backup_frequency = day
restore_test_frequency = quarter
lockout_threshold = 3
lockout_minutes = 0
password_min_length = 12
password_history = 5
inactivity_disable_days = 90
screen_lock_minutes = 15
audit_retention_days = 90
patch_cadence = monthly
critical_patch_hours = 72
incident_report_hours = 72

# yes or no: switches sections on or off (an "off" section says "Not applicable" and why).
[facts]
has_outside_it_provider = no
