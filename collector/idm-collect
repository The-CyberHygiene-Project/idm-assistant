#!/bin/sh
# CyberHygiene Project Lab Installer — based on Rocky Linux 9.
# Not an official Rocky Linux product.
# Rocky Linux is a trademark of the Rocky Enterprise Software Foundation.
# idm-collect [--user NAME]: READ-ONLY identity diagnostics for the dc2-style stack. Prints one idm-report/1 JSON
# document on stdout. Writes nothing outside a private temp dir (removed on exit). Secrets are redacted with
# redact.sed (installed by the RPM as /usr/share/idm-collect/redact.sed).
# Kanidm queries use the REST API with a READ-ONLY service-account token (/etc/idm-collect/kanidm.token), passed to
# curl as a header FILE (never on the command line), so no CLI token cache is written anywhere.
set -eu
set -f   # no pathname expansion anywhere: group names and paths are data, never patterns
PATH=/usr/sbin:/usr/bin:/sbin:/bin
# >>> redact-path
# As root (the sudo rule) the installed rules are used whatever the environment says: GNU sed -f accepts `w`/`e`.
if [ "$(id -u)" -eq 0 ]; then REDACT=/usr/share/idm-collect/redact.sed
else REDACT="${IDM_REDACT:-/usr/share/idm-collect/redact.sed}"; fi
# <<< redact-path
TOKEN_FILE=/etc/idm-collect/kanidm.token
# >>> kanidm-url
# The Kanidm URL is site data (/etc/idm-collect/collect.conf, written by the client role), never baked in. Only
# https://<lower-case host>[:port] is accepted; anything else leaves it empty and the Kanidm checks report an error.
if [ "$(id -u)" -eq 0 ]; then CONF=/etc/idm-collect/collect.conf; else CONF="${IDM_COLLECT_CONF:-/etc/idm-collect/collect.conf}"; fi
KANIDM_URL=$(sed -n 's/^KANIDM_URL=//p' "$CONF" 2>/dev/null | tail -n 1)
# Character lists are spelled out: a range like a-z follows the locale's collation and can match upper case.
lc=abcdefghijklmnopqrstuvwxyz0123456789
case "$KANIDM_URL" in
  https://*) _h=${KANIDM_URL#https://}
             case "$_h" in ''|*[!$lc.:-]*|:*|*:|*:*:*) KANIDM_URL="" ;; esac ;;
  *) KANIDM_URL="" ;;
esac
KANIDM_HOSTPORT=""
if [ -n "$KANIDM_URL" ]; then
  _h=${KANIDM_URL#https://}; case "$_h" in *:*) KANIDM_HOSTPORT=$_h ;; *) KANIDM_HOSTPORT=$_h:443 ;; esac
fi
# The site's CA root anchor (its file name and CA name are site data too): a plain file in the anchors directory.
CA_ANCHOR=$(sed -n 's/^CA_ANCHOR=//p' "$CONF" 2>/dev/null | tail -n 1)
case "${CA_ANCHOR#/etc/pki/ca-trust/source/anchors/}" in
  "$CA_ANCHOR"|''|*[!$lc._-]*|.*) CA_ANCHOR="" ;;
esac
# <<< kanidm-url
user=""
[ "${1:-}" = "--user" ] && user="${2:-}"
case "$user" in ''|[a-z0-9_]*) : ;; *) echo '{"schema":"idm-report/1","errors":["bad --user"]}'; exit 0 ;; esac
case "$user" in *[!a-z0-9_]*) echo '{"schema":"idm-report/1","errors":["bad --user"]}'; exit 0 ;; esac
W=$(mktemp -d /tmp/idm-collect.XXXXXX); chmod 700 "$W"; trap 'rm -rf "$W"' EXIT
ERRS="$W/errors"; : > "$ERRS"
err() { printf '%s\n' "$1" | sed -E -f "$REDACT" >> "$ERRS"; }
# >>> config-errors
# A missing or garbled site value is reported as what it is, never as a network or trust fault further down.
[ -n "$KANIDM_URL" ] || err "collect.conf: KANIDM_URL missing or invalid (want https://host[:port])"
[ -n "$CA_ANCHOR" ] || err "collect.conf: CA_ANCHOR missing or invalid (want a file in /etc/pki/ca-trust/source/anchors/)"
# <<< config-errors

# >>> json-helpers
# JSON string escaping (POSIX): backslash, quote, control characters -> spaces; redaction first.
# An empty value must still print "" (sed emits nothing for empty input, which broke the report when chrony had no
# reference: "source":,).
json_str() { [ -n "$1" ] || { printf '""'; return; }; printf '%s' "$1" | sed -E -f "$REDACT" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037' | sed 's/^/"/; s/$/"/'; }
json_bool() { case "$1" in true) printf true ;; null) printf null ;; *) printf false ;; esac; }   # null = unknown
json_num() { case "$1" in ''|*[!0-9.eE+-]*) printf null ;; *) printf '%s' "$1" ;; esac; }
# memberof from Kanidm's person JSON as a JSON array, or null when absent/unreadable (unknown is not "no groups").
memberof_json() {
  printf '%s' "$1" | grep -q '"memberof":\[' || { printf null; return; }
  _mo=$(printf '%s' "$1" | sed -n 's/.*"memberof":\[\([^]]*\)\].*/\1/p')
  case "$_mo" in *[!a-z0-9_@.,\"-]*) printf null ;; *) printf '[%s]' "$_mo" ;; esac
}
# <<< json-helpers
# >>> parsers
# Pure text parsers (unit-tested on the Mac with real output shapes).
validity_json() {   # $1 = Kanidm person JSON, $2 = attribute -> "YYYY-MM-DDTHH:MM:SSZ" (fraction dropped) or null
  _v=$(printf '%s' "$1" | sed -n "s/.*\"$2\":\[\"\([^\"]*\)\".*/\1/p" | sed 's/\.[0-9]*//')
  case "$_v" in ''|*[!0-9TZ:+-]*) printf null ;; *) printf '"%s"' "$_v" ;; esac
}
cert_validity() {   # ssh-keygen -L text -> "FROM TO" ("-" when absent; TO may be "forever")
  _l=$(printf '%s\n' "$1" | sed -n 's/^[[:space:]]*Valid: //p' | head -1)
  case "$_l" in
    forever) echo "- forever" ;;
    "from "*" to "*) printf '%s\n' "$_l" | awk '{print $2, $4}' ;;
    *) echo "- -" ;;
  esac
}
principals_json() {   # ssh-keygen -L text -> JSON array of principals
  _p=""
  for _x in $(printf '%s\n' "$1" | awk '/^[[:space:]]*Principals:/ {p = 1; next} /^[[:space:]]*[A-Z][A-Za-z ]*:/ {p = 0} p {print $1}'); do
    _p="$_p$(json_str "$_x"),"
  done
  printf '[%s]' "${_p%,}"
}
relabel_json() {   # restorecon -n -v output -> [{"path","have","want"}] (SELinux types only)
  _r=""
  _t=$(printf '%s\n' "$1" | awk '$1 == "Would" && $2 == "relabel" && $4 == "from" && $6 == "to" {
    split($5, a, ":"); split($7, b, ":"); print $3, a[3], b[3] }')
  while read -r _p _a _b; do
    [ -n "$_p" ] || continue
    _r="$_r{\"path\":$(json_str "$_p"),\"have\":$(json_str "$_a"),\"want\":$(json_str "$_b")},"
  done <<EOF
$_t
EOF
  printf '[%s]' "${_r%,}"
}
# <<< parsers
iso() { date -u -d "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true; }
isoj() { _i=$(iso "$1"); if [ -n "$_i" ]; then json_str "$_i"; else printf null; fi; }   # unconvertible -> null

host=$(hostname -s)
if systemctl cat kanidmd.service >/dev/null 2>&1; then role=server; else role=client; fi
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- time ---------------------------------------------------------------------------------------------------------
off=""; synced=false; src=""
if t=$(chronyc -n tracking 2>/dev/null); then
  src=$(printf '%s\n' "$t" | awk -F': *' '/^Reference ID/ {split($2,a," "); print a[2]}' | tr -d '()')
  # "System time : 0.000012 seconds fast of NTP time" -> signed offset (local minus NTP)
  off=$(printf '%s\n' "$t" | awk -F': *' '/^System time/ {split($2,a," "); v=a[1]; if ($2 ~ /slow/) v=-v; print v}')
  printf '%s\n' "$t" | grep -q '^Leap status *: Normal' && synced=true
else err "time: chronyc tracking failed"; fi
# >>> source-offset
# Last measurement of the first source, e.g. "^* 192.168.100.1 10 6 377 12 -52us[  -58us] +/- 242us" -> -0.000058
# (chrony pads inside the brackets; units ns/us/ms/s).
# chrony shows the jump here ~2 min before tracking does (measured), so skew is visible at once.
soff=$(chronyc -n sources 2>/dev/null | awk '/^\^/ { if (match($0, /\[[^]]*\]/)) { v = substr($0, RSTART + 1, RLENGTH - 2); gsub(/[[:space:]]/, "", v);
  u = v; gsub(/[-+0-9.]/, "", u); n = v; gsub(/[a-z]/, "", n);
  m = (u == "ns") ? 1e-9 : (u == "us") ? 1e-6 : (u == "ms") ? 1e-3 : 1; printf "%.6f\n", n * m; exit } }')
# <<< source-offset

# --- services -----------------------------------------------------------------------------------------------------
if [ "$role" = server ]; then units="kanidmd step-ca named cert-renew-kanidm.timer"
else units="kanidm-unixd kanidm-unixd-tasks sshd"; fi
svc=""
for u in $units; do st=$(systemctl is-active "$u" 2>/dev/null || true); svc="$svc$(json_str "$u"):$(json_str "${st:-unknown}"),"; done
svc="{${svc%,}}"

# --- TLS (Kanidm) ------------------------------------------------------------------------------------------------
# >>> tls
tls="{}"
if [ -z "$KANIDM_HOSTPORT" ]; then
  :   # no usable KANIDM_URL: reported under config-errors, and no probe is a guess at the wrong host
elif out=$(timeout 10 openssl s_client -connect "$KANIDM_HOSTPORT" -servername "${KANIDM_HOSTPORT%:*}" </dev/null 2>&1) \
   && printf '%s\n' "$out" | grep -q -- '-----BEGIN CERTIFICATE-----'; then
  printf '%s\n' "$out" | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' > "$W/kanidm.pem"
  nb=$(iso "$(openssl x509 -in "$W/kanidm.pem" -noout -startdate | cut -d= -f2)")
  na=$(iso "$(openssl x509 -in "$W/kanidm.pem" -noout -enddate | cut -d= -f2)")
  # s_client verifies the chain against the system trust store: 0 ok, 10 expired, anything else untrusted.
  code=$(printf '%s\n' "$out" | sed -n 's/.*Verify return code: \([0-9]*\).*/\1/p' | tail -1)
  case "$code" in 0) v=ok ;; 10) v=expired ;; *) v=untrusted ;; esac
  tls="{\"kanidm\":{\"not_before\":$(json_str "$nb"),\"not_after\":$(json_str "$na"),\"verify\":$(json_str "$v")}}"
else err "tls: could not fetch the Kanidm certificate (unreachable or handshake failed)"; fi
# <<< tls

# --- user lookup (clients, --user) --------------------------------------------------------------------------------
# Before the unixd section on purpose: `kanidm-unix status` is only fresh after a lookup needed the server (measured).
un=null
if [ -n "$user" ] && [ "$role" = client ]; then
  if p=$(timeout 15 getent passwd "$user" 2>/dev/null); then
    gl=""; for g in $(timeout 15 id -Gn "$user" 2>/dev/null); do gl="$gl$(json_str "$g"),"; done
    un="{\"name\":$(json_str "$user"),\"found\":true,\"gecos\":$(json_str "$(printf '%s' "$p" | cut -d: -f5)"),\"groups\":[${gl%,}]}"
  else un="{\"name\":$(json_str "$user"),\"found\":false}"; fi
fi

# --- failed-login lockout (faillock) for --user ------------------------------------------------------------------
# >>> faillock
# The limit and lock time come from faillock.conf (pam_faillock's defaults 3 / 600 s when unset; "never" -> null),
# the failures from faillock(8). Unknown (no user, no tool) is null, never "not locked".
if [ "$(id -u)" -eq 0 ]; then FCONF=/etc/security/faillock.conf; else FCONF="${FAILLOCK_CONF:-/etc/security/faillock.conf}"; fi
flk=null
if [ -n "$user" ] && command -v faillock >/dev/null 2>&1 && fout=$(faillock --user "$user" 2>/dev/null); then
  fdeny=$(sed -n 's/^[[:space:]]*deny[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$FCONF" 2>/dev/null | tail -n 1)
  fut=$(sed -n 's/^[[:space:]]*unlock_time[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$FCONF" 2>/dev/null | tail -n 1)
  ffl=""
  frows=$(printf '%s\n' "$fout" | awk '$1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && NF >= 4 {
            src = (NF >= 5) ? $4 : ""; printf "%s %s|%s|%s|%s\n", $1, $2, $3, $NF, src }')
  # '|' (not tab): read merges runs of whitespace separators, so an empty Source column would vanish. Source is last,
  # so a '|' inside it cannot shift the other fields.
  while IFS='|' read -r fw fty fva fsrc; do
    [ -n "$fw" ] || continue
    # faillock prints LOCAL time without a zone: read it as local, print it in UTC.
    fs=$(date -d "$fw" +%s 2>/dev/null) && fwi=$(date -u -d "@$fs" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || fwi=""
    fwj=null; [ -n "$fwi" ] && fwj=$(json_str "$fwi")
    fv=false; [ "$fva" = V ] && fv=true
    ffl="$ffl{\"when\":$fwj,\"type\":$(json_str "$fty"),\"source\":$(json_str "$fsrc"),\"valid\":$fv},"
  done <<EOF
$frows
EOF
  case "$fdeny" in ''|*[!0-9]*) fdeny=3 ;; esac
  case "$fut" in '') fut=600 ;; *[!0-9]*) fut=null ;; esac
  # A zero-padded value (deny = 03) would print an invalid JSON number and lose the whole report: drop leading zeros.
  fdeny=$(printf '%s' "$fdeny" | sed 's/^0*\([0-9]\)/\1/')
  [ "$fut" = null ] || fut=$(printf '%s' "$fut" | sed 's/^0*\([0-9]\)/\1/')
  flk="{\"deny\":$fdeny,\"unlock_time_s\":$fut,\"failures\":[${ffl%,}]}"
fi
# <<< faillock
# --- how the identity server's name resolves (clients) / own addresses (server) ----------------------------------
# >>> name
# getent is the lookup path the login service itself uses. source: files when a non-comment hosts line names the host
# (compared as glibc does: case-insensitive, trailing dot ignored).
# resolver_state: a TCP connect to the first DNS server's port 53: answers, refused (the machine is up but no DNS
# service listens), or unreachable. Only address-shaped strings are kept.
if [ "$(id -u)" -eq 0 ]; then HOSTS_FILE=/etc/hosts; RESOLV=/etc/resolv.conf
else HOSTS_FILE="${IDM_HOSTS_FILE:-/etc/hosts}"; RESOLV="${IDM_RESOLV_CONF:-/etc/resolv.conf}"; fi
isip() { case "$1" in ''|*[!0-9a-fA-F.:]*) return 1 ;; *[.:]*) return 0 ;; *) return 1 ;; esac; }
nm=null; own=null
if [ "$role" = client ] && [ -n "$KANIDM_HOSTPORT" ]; then
  nh=${KANIDM_HOSTPORT%:*}
  na=""
  for a in $(timeout 5 getent ahosts "$nh" 2>/dev/null | awk '{print $1}' | awk '!s[$0]++'); do
    isip "$a" && na="$na$(json_str "$a"),"
  done
  nsl=$(sed -n 's/^[[:space:]]*nameserver[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$RESOLV" 2>/dev/null) || nsl=""   # set -e: a missing resolv.conf must not end the report
  ns=""; r1=""
  for a in $nsl; do if isip "$a"; then ns="$ns$(json_str "$a"),"; [ -n "$r1" ] || r1=$a; fi; done
  nsrc=null
  if sed 's/#.*//' "$HOSTS_FILE" 2>/dev/null | awk -v h="$nh" '{for (i = 2; i <= NF; i++) { n = tolower($i); sub(/[.]$/, "", n); if (n == h) f = 1 }} END {exit !f}'; then
    nsrc='"files"'
  elif [ -n "$na" ]; then nsrc='"dns"'; fi
  rst=null
  if [ -n "$r1" ]; then
    # A bare TCP connect (bash /dev/tcp), closed at once: curl's exit 7 also covers "no route", and curl telnet held the
    # connection until named's 30 s idle limit (measured). Only the kernel's "Connection refused" means the machine is
    # up with no DNS service; any other failure (no route, firewall reject, blackhole, timeout) is unreachable.
    rc=0
    # shellcheck disable=SC2016  # $1 is the inner bash's argument: the address is data, never part of the script text
    perr=$(timeout 3 bash -c 'exec 3<>"/dev/tcp/$1/53"' _ "$r1" 2>&1 >/dev/null) || rc=$?
    if [ "$rc" -eq 0 ]; then rst='"answers"'
    else case "$perr" in *"Connection refused"*) rst='"refused"' ;; *) rst='"unreachable"' ;; esac; fi
  fi
  nm="{\"host\":$(json_str "$nh"),\"addresses\":[${na%,}],\"source\":$nsrc,\"resolvers\":[${ns%,}],\"resolver_state\":$rst}"
fi
if [ "$role" = server ]; then
  oa=""; for a in $(hostname -I 2>/dev/null); do isip "$a" && oa="$oa$(json_str "$a"),"; done
  own="[${oa%,}]"
fi
# <<< name
# --- fapolicyd: state and recent execute denials ------------------------------------------------------------------
# >>> fapolicyd
# Denials come from the audit log (rule 90 is deny_audit); --input-logs because over ssh/sudo ausearch would read stdin.
# Per denied path: still there?, the owning package and the key that signed it (rpm -qf prints its "not owned" text on
# stdout with exit 1, so rpm's own status decides), and whether fapolicyd trusts it now (field 2 of fapolicyd-cli -D).
if [ "$(id -u)" -eq 0 ]; then FAPCONF=/etc/fapolicyd/fapolicyd.conf; FAPDIR=/etc/fapolicyd
else FAPCONF="${IDM_FAPOLICYD_CONF:-/etc/fapolicyd/fapolicyd.conf}"; FAPDIR="${IDM_FAPOLICYD_DIR:-/etc/fapolicyd}"; fi
fap=null
if command -v fapolicyd-cli >/dev/null 2>&1; then
  fact=$(systemctl is-active fapolicyd 2>/dev/null) || fact=${fact:-unknown}
  fpm=$(sed -n 's/^[[:space:]]*permissive[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$FAPCONF" 2>/dev/null | tail -n 1)
  case "$fpm" in 1) fpj=true ;; 0) fpj=false ;; *) fpj=null ;; esac
  fdok=1; fapolicyd-cli -D > "$W/fapolicyd.dump" 2>/dev/null || fdok=0
  fgrp=$(ausearch --input-logs -m FANOTIFY -ts recent 2>/dev/null </dev/null | awk '
      function flush() { if (fan && sc && p != "") printf "%s|%s|%s\n", t, u, p; fan = sc = 0; p = u = t = "" }
      /^----/ { flush(); next }
      /type=FANOTIFY/ && / resp=2/ { fan = 1 }                   # resp=2 is a denial; allow_audit logs resp=1
      /type=SYSCALL/ && / syscall=59 / && / success=no / { sc = 1; if (match($0, / uid=[0-9]+/)) u = substr($0, RSTART + 5, RLENGTH - 5) }
      /type=PATH/ && /name="/ { if (match($0, /name="[^"]*"/)) p = substr($0, RSTART + 6, RLENGTH - 7) }
      /msg=audit\(/ { if (match($0, /audit\([0-9]+/)) t = substr($0, RSTART + 6, RLENGTH - 6) }
      END { flush() }' | awk -F'|' '$3 ~ /^\/[A-Za-z0-9._\/+-]+$/ { c[$3]++; if ($1 + 0 >= t[$3] + 0) { t[$3] = $1; u[$3] = $2 } }
      END { for (p in c) printf "%s|%s|%s|%s\n", t[p], u[p], c[p], p }' | sort -t'|' -k1,1nr | head -n 5) || fgrp=""
  fl=""
  while IFS='|' read -r ft fu fc fp; do
    [ -n "$fp" ] || continue
    fe=false; [ -e "$fp" ] && fe=true
    fpk=null; fsg=null
    if pk=$(rpm -qf --qf '%{NAME}\n' "$fp" 2>/dev/null); then
      pk=$(printf '%s\n' "$pk" | head -n 1)
      case "$pk" in ''|*[!A-Za-z0-9._+-]*) ;; *) fpk=$(json_str "$pk")
        sg=$(rpm -qf --qf '%{RSAHEADER:pgpsig}|%{DSAHEADER:pgpsig}|%{SIGPGP:pgpsig}\n' "$fp" 2>/dev/null \
             | grep -o 'Key ID [0-9a-f]*' | head -n 1 | cut -d' ' -f3) || sg=""
        [ -n "$sg" ] && fsg=$(json_str "$sg") ;; esac
    fi
    if [ "$fdok" -eq 0 ]; then fit=null
    elif awk -v p="$fp" '$2 == p {f = 1} END {exit !f}' "$W/fapolicyd.dump"; then fit=true; else fit=false; fi
    fw=$(date -u -d "@$ft" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || fw=""
    fwj=null; [ -n "$fw" ] && fwj=$(json_str "$fw")
    fl="$fl{\"path\":$(json_str "$fp"),\"when\":$fwj,\"uid\":$(json_num "$fu"),\"count\":$(json_num "$fc"),\"exists\":$fe,\"package\":$fpk,\"signer\":$fsg,\"in_trust\":$fit},"
  done <<EOF
$fgrp
EOF
  # What a refresh (fapolicyd-cli --update, which reloads the WHOLE package database and the trust files) would newly
  # trust: packages with a regular file but none of them in the trust list (never loaded), with their signers; and
  # trust-file entries not loaded yet. fapolicyd leaves most data files out, so "never loaded" is per package.
  fpend=null; fpt=null
  if [ "$fdok" -eq 1 ]; then
    awk '{print $2}' "$W/fapolicyd.dump" > "$W/fap.trusted"
    rpm -qa --qf '[%{=NAME}|%{FILENAMES}|%{FILEMODES:perms}\n]' > "$W/fap.files" 2>/dev/null || : > "$W/fap.files"
    rpm -qa --qf '%{NAME}|%{RSAHEADER:pgpsig}|%{DSAHEADER:pgpsig}|%{SIGPGP:pgpsig}\n' > "$W/fap.sigs" 2>/dev/null || : > "$W/fap.sigs"
    fpl=$(awk -F'|' 'NR == FNR {d[$1] = 1; next} $3 ~ /^-/ {if (!($1 in h)) h[$1] = 0; if ($2 in d) h[$1] = 1}
                     END {for (p in h) if (!h[p]) print p}' "$W/fap.trusted" "$W/fap.files" | sort) || fpl=""
    fn=$(printf '%s\n' "$fpl" | awk 'NF {n++} END {print n + 0}')
    pj=$(printf '%s\n' "$fpl" | head -n 100 | awk -F'|' 'NR == FNR {k = ""; if (match($0, /Key ID [0-9a-f]+/)) k = substr($0, RSTART + 7, RLENGTH - 7); s[$1] = k; next}
            /^[A-Za-z0-9._+-]+$/ {printf "{\"name\":\"%s\",\"signer\":%s},", $0, (s[$0] != "" ? "\"" s[$0] "\"" : "null")}' "$W/fap.sigs" -) || pj=""
    ftr=false; [ "$fn" -gt 100 ] && ftr=true
    fpend="{\"packages\":[${pj%,}],\"truncated\":$ftr}"
    fpt=$(cat "$FAPDIR/fapolicyd.trust" "$FAPDIR"/trust.d/* 2>/dev/null | sed 's/#.*//' \
          | awk 'NR == FNR {d[$1] = 1; next} NF && !($1 in d) {n++} END {print n + 0}' "$W/fap.trusted" -) || fpt=null
  fi
  fap="{\"active\":$(json_str "$fact"),\"permissive\":$fpj,\"denials\":[${fl%,}],\"pending\":$fpend,\"file_trust_pending\":$fpt}"
fi
# <<< fapolicyd

# --- NSS order + authselect (clients) -----------------------------------------------------------------------------
nss=null; asel=null
if [ "$role" = client ]; then
  n=""; for m in passwd group initgroups; do
    v=$(sed -n "s/^$m:[[:space:]]*//p" /etc/nsswitch.conf | head -1); n="$n$(json_str "$m"):$(json_str "$v"),"; done
  nss="{${n%,}}"
  av=false; authselect check >/dev/null 2>&1 && av=true
  asel="{\"profile\":$(json_str "$(authselect current 2>/dev/null | sed -n 's/^Profile ID: //p')"),\"valid\":$(json_bool $av)}"
fi

# --- unixd (clients) ----------------------------------------------------------------------------------------------
ux=absent
if [ "$role" = client ]; then
  if s=$(kanidm-unix status 2>/dev/null); then
    if printf '%s\n' "$s" | grep -qi '^Kanidm: *online'; then ux=online; else ux=offline; fi
  else err "unixd: kanidm-unix status failed"; ux=offline; fi
fi

# --- Kanidm user (server role, --user) ----------------------------------------------------------------------------
ku=null
if [ -n "$user" ] && [ "$role" = server ]; then
  if [ -z "$KANIDM_URL" ]; then
    :   # already reported under config-errors; no query without a usable URL
  elif [ -r "$TOKEN_FILE" ]; then
    printf 'Authorization: Bearer %s\n' "$(cat "$TOKEN_FILE")" > "$W/auth.hdr"; chmod 600 "$W/auth.hdr"
    if j=$(curl -fsS --max-time 10 -H @"$W/auth.hdr" "$KANIDM_URL/v1/person/$user" 2>"$W/curl.err"); then
      if [ "$j" = null ] || [ -z "$j" ]; then
        ku="{\"name\":$(json_str "$user"),\"exists\":false}"
      else
        has() { printf '%s' "$j" | grep -q "\"$1\""; }
        posix=false; printf '%s' "$j" | grep -q '"posixaccount"' && posix=true
        upw=false; has unix_password && upw=true
        pc=false; has primary_credential && pc=true
        mo=$(memberof_json "$j")
        [ "$mo" = null ] && err "kanidm_user: memberof missing or unreadable (reported as unknown)"
        ae=$(validity_json "$j" account_expire); vf=$(validity_json "$j" account_valid_from)
        ku="{\"name\":$(json_str "$user"),\"exists\":true,\"posix\":$(json_bool $posix),\"unix_password\":$(json_bool $upw),\"primary_credential\":$(json_bool $pc),\"memberof\":$mo,\"account_expire\":$ae,\"valid_from\":$vf}"
      fi
    else err "kanidm_user: REST query failed: $(head -c 200 "$W/curl.err")"; fi
  else err "kanidm_user: no read-only token at $TOKEN_FILE"; fi
fi

# --- SSH CA (server): its key fingerprint and, with --user, the newest certificate it issued (public record) ------
sca=null
if [ "$role" = server ] && [ -r /etc/ssh-ca/user_ca.pub ]; then
  cafp=$(ssh-keygen -lf /etc/ssh-ca/user_ca.pub 2>/dev/null | awk '{print $2}')
  iss=null
  if [ -n "$user" ] && [ -r "/var/lib/ssh-ca/issued/$user-cert.pub" ]; then
    cl=$(TZ=UTC ssh-keygen -L -f "/var/lib/ssh-ca/issued/$user-cert.pub" 2>/dev/null)
    read -r cf ct <<EOF
$(cert_validity "$cl")
EOF
    # ssh-keygen prints zone-less LOCAL time: TZ=UTC above makes it UTC, which iso() (date -u) then reads correctly
    if [ "$cf" = - ]; then cfj=null; else cfj=$(isoj "$cf"); fi
    case "$ct" in forever) ctj='"forever"' ;; -) ctj=null ;; *) ctj=$(isoj "$ct") ;; esac
    iss="{\"user\":$(json_str "$user"),\"valid_from\":$cfj,\"valid_to\":$ctj,\"principals\":$(principals_json "$cl")}"
  fi
  sca="{\"fingerprint\":$(json_str "$cafp"),\"issued\":$iss}"
fi

# --- sshd trust (client): effective TrustedUserCAKeys and the fingerprints in that file ---------------------------
ssd=null
if [ "$role" = client ]; then
  tp=$(sshd -T 2>/dev/null | awk '$1 == "trustedusercakeys" {print $2}')
  [ -n "$tp" ] || err "sshd: sshd -T gave no trustedusercakeys (config error?)"
  fl=""
  if [ -n "$tp" ] && [ "$tp" != none ] && [ -r "$tp" ]; then
    for f in $(ssh-keygen -lf "$tp" 2>/dev/null | awk '{print $2}'); do fl="$fl$(json_str "$f"),"; done
  fi
  ssd="{\"trusted_ca_path\":$(json_str "${tp:-none}"),\"trusted_ca_fingerprints\":[${fl%,}]}"
fi

# --- trust --------------------------------------------------------------------------------------------------------
# >>> trust
tr_ok=false
[ -n "$CA_ANCHOR" ] || tr_ok=null   # unknown, not "missing": without a configured anchor there is nothing to check
# The anchor file is present AND the system trust store lists its CA (matched by the anchor's own subject CN).
if [ -n "$CA_ANCHOR" ] && [ -f "$CA_ANCHOR" ]; then
  cn=$(openssl x509 -in "$CA_ANCHOR" -noout -subject -nameopt multiline 2>/dev/null | sed -n 's/^ *commonName *= *//p' | head -n 1)
  if [ -n "$cn" ] && trust list --filter=ca-anchors 2>/dev/null | grep -qiF -- "$cn"; then tr_ok=true; fi
fi
# <<< trust

# --- SELinux ------------------------------------------------------------------------------------------------------
se=$(getenforce 2>/dev/null || echo unknown)
avc=$(ausearch --input-logs -m AVC -ts recent 2>/dev/null </dev/null | grep -c 'type=AVC' || true)
# Labels that differ from policy on a FIXED list of identity paths (restorecon -n = dry run, changes nothing).
# A wrong label here can fail logins with no AVC at all (dontaudit), so this is the evidence, not the AVC count.
rl=""
for pth in /run/kanidm-unixd /var/cache/kanidm-unixd /var/lib/kanidm-unixd /etc/kanidm /etc/ssh/trusted_user_ca_keys \
           /etc/pki/ca-trust/source/anchors; do
  [ -e "$pth" ] && rl="$rl $pth"
done
relab="[]"
# shellcheck disable=SC2086  # $rl is a list of fixed paths; globbing is off (set -f)
[ -n "$rl" ] && relab=$(relabel_json "$(restorecon -n -v -R $rl 2>/dev/null)")

# --- emit ---------------------------------------------------------------------------------------------------------
errs=""
while IFS= read -r l; do errs="$errs$(json_str "$l"),"; done < "$ERRS"
printf '{"schema":"idm-report/1","host":%s,"role":%s,"collected_at":%s,"user":%s,' \
  "$(json_str "$host")" "$(json_str "$role")" "$(json_str "$now")" "$( [ -n "$user" ] && json_str "$user" || printf null)"
printf '"time":{"offset_s":%s,"synced":%s,"source":%s,"source_offset_s":%s},' "$(json_num "$off")" \
  "$(json_bool $synced)" "$(json_str "$src")" "$(json_num "$soff")"
printf '"nss":%s,"authselect":%s,"user_nss":%s,' "$nss" "$asel" "$un"
printf '"services":%s,"tls":%s,"unixd":{"status":%s},"kanidm_user":%s,' "$svc" "$tls" "$(json_str "$ux")" "$ku"
printf '"ssh_ca":%s,"sshd":%s,' "$sca" "$ssd"
printf '"faillock":%s,' "$flk"
printf '"name":%s,"own_addresses":%s,' "$nm" "$own"
printf '"fapolicyd":%s,' "$fap"
printf '"trust":{"kanidm_root_in_store":%s},"selinux":{"mode":%s,"avc_recent":%s,"relabel":%s},"errors":[%s]}\n' \
  "$(json_bool $tr_ok)" "$(json_str "$se")" "$(json_num "$avc")" "$relab" "${errs%,}"
