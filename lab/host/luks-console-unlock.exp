#!/usr/bin/expect -f
# luks-console-unlock.exp VM  (on aero, as root): answer a LUKS passphrase prompt on the VM's serial console.
# The passphrase is read from stdin (never argv). Used when TPM unlock does not happen (e.g. PCR mismatch).
set timeout 120
set vm [lindex $argv 0]
gets stdin pass
log_user 0
spawn virsh console --force $vm
# Only answer a prompt that is really pending: the console log (pty log.file) must END with "Please enter passphrase".
# Never send blind - after a TPM unlock the passphrase would be typed at `login:` and echoed into the log.
set logf "/var/log/libvirt/qemu/$vm-install.log"
set tailtxt [exec tail -c 400 $logf]
regsub -all {\x1b\[[0-9;?]*[a-zA-Z]} $tailtxt {} tailtxt
set lines [lsearch -all -inline -not -regexp [split [string map {"\r" "\n"} $tailtxt] "\n"] {^\s*$}]
if {![regexp {Please enter passphrase} [lindex $lines end]]} {
  puts stderr "no pending passphrase prompt (last console line: [lindex $lines end]); refusing to send"
  send -- "\035"; exit 1
}
send -- "$pass\r"; puts "passphrase sent (pending prompt confirmed)"
set timeout 180
expect {
  -re {(?i)(login:|Reached target|Started)} { puts "boot continued after a typed passphrase" }
  -re {(?i)(no key available|wrong|invalid)[^\r\n]*} { puts stderr "unlock refused: $expect_out(0,string)"; exit 1 }
  timeout { puts stderr "no progress after passphrase"; exit 1 }
}
send -- "\035"
exit 0
