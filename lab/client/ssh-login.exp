#!/usr/bin/expect -f
# ssh-login.exp USER [WHICH] [HOST] [SECRETS]  (runs on the Mac). Logs in over SSH with keyboard-interactive/password
# and runs `id`. HOST defaults to client2 (192.168.100.13); SECRETS defaults to ~/idm-lab-secrets/USER.json.
# WHICH = posix (default) | primary | wrong  selects the password sent. Every prompt is printed as "PROMPT: <text>"
# (never the answers); TOTP/verification-code prompts get a live code using the file's totp_algorithm (default sha1).
set timeout 20
set user [lindex $argv 0]
set which [expr {[llength $argv] > 1 ? [lindex $argv 1] : "posix"}]
set host [expr {[llength $argv] > 2 ? [lindex $argv 2] : "192.168.100.13"}]
set sfile [expr {[llength $argv] > 3 ? [lindex $argv 3] : "$env(HOME)/idm-lab-secrets/$user.json"}]
set f [open $sfile]; set js [read $f]; close $f
proc jget {js k} { if {[regexp "\"$k\": *\"(\[^\"\]*)\"" $js -> v]} { return $v }; return "" }
set pw [jget $js posix_password]
if {$which eq "primary"} { set pw [jget $js password] }
if {$which eq "wrong"} { set pw "definitely-not-the-password-123" }
set sec [jget $js totp_secret]
set alg [jget $js totp_algorithm]; if {$alg eq ""} { set alg sha1 }
log_user 0
spawn ssh -o PubkeyAuthentication=no -o PreferredAuthentications=keyboard-interactive,password \
  -o StrictHostKeyChecking=accept-new -o NumberOfPasswordPrompts=1 $user@$host id
set n 0
expect {
  -re {(?i)([^\r\n]*(password|passcode)[^\r\n]*: ?)$} {
    puts "PROMPT: [string trim $expect_out(1,string)]"; send -- "$pw\r"; incr n; if {$n < 4} { exp_continue } }
  -re {(?i)([^\r\n]*(totp|code|token|otp|verification)[^\r\n]*: ?)$} {
    puts "PROMPT: [string trim $expect_out(1,string)]"
    set code [exec python3 [file dirname [info script]]/../tools/totp.py - $alg << $sec]; send -- "$code\r"; incr n; if {$n < 4} { exp_continue } }
  -re {uid=[^\r\n]+} { puts "RESULT: $expect_out(0,string)"; exp_continue }
  -re {(?i)(permission denied|authentication failed|access denied)[^\r\n]*} { puts "RESULT: DENIED ($expect_out(0,string))"; exp_continue }
  eof {}
  timeout { puts "RESULT: TIMEOUT" }
}
