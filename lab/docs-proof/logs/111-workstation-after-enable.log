## logind
# /etc/systemd/logind.conf.d/50-chp-docs.conf (chp-onlyoffice; ISO 0.7.0 Plan 3, ruling F3).
# Logging out ends the user's processes, so neither an ONLYOFFICE left open (the spike saw it survive
# `loginctl terminate-session`) nor anything else keeps the user manager and $XDG_RUNTIME_DIR (where `chp-site doc`
# keeps the sign-in tokens) alive after the last session. Linger stays off: chp-site onlyoffice enable and the hourly
# sweep turn it off for anyone who has it, and 50-chp-no-linger.rules (polkit) refuses users turning it on.
# Takes effect at the next boot (logind is not restarted under a running desktop).
[Login]
KillUserProcesses=yes
KillExcludeUsers=root
49-polkit-pkla-compat.rules
50-chp-no-linger.rules
50-default.rules
## xdg
; /etc/xdg/onlyoffice/DesktopEditors.conf (chp-onlyoffice; ISO 0.7.0 Plan 3 Task 8, spike gate G4): system-wide
; defaults (Qt reads them for keys the user's ~/.config/onlyoffice/DesktopEditors.conf does not set).
; Key names come from the 10.0.0 binary (spike §Editor and Task 8's reading of the start page); the vendor documents
; none of them. autoUpdateMode: no update check. lockPortals: no cloud portals. pluginsDisabled: no plugins.
; useai: the start page's "AI Chat" and AI Tools entries hidden (what "Don't show me ONLYOFFICE AI Tools" sets).
; The controls that are PROVEN are the removed AI Tools plugin, the egress table and the /etc/hosts block.
[General]
autoUpdateMode=disabled
lockPortals=true
pluginsDisabled=true
useai=false
