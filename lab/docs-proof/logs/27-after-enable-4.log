== egress table
table inet chp_nextcloud_egress {
	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid 48 jump apache_out
	}

	chain apache_out {
		meta l4proto { tcp, udp } th dport 53 log prefix "CHP-NC-EGRESS-DNS " flags skuid counter packets 0 bytes 0 reject
		oifname "lo" accept
		ip daddr { 127.0.0.0/8, 192.168.100.50 } accept
		ip6 daddr ::1 accept
		ct state established,related accept
		log prefix "CHP-NC-EGRESS " flags skuid counter packets 0 bytes 0 reject
	}
}
