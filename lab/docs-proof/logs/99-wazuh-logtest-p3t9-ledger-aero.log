---- lt.sh ----
#!/bin/bash
# wazuh-logtest-legacy on a throwaway copy of /var/ossec in a private mount namespace (Plan 2 Task 9d method).
# usage: sudo unshare -m --propagation private bash lt.sh SRC MODE ; SRC holds chp_*.xml + lines.txt
set -u
W=/var/tmp/wz-lt.$$; SRC=$1; MODE=$2
mkdir -p $W
for d in /var/ossec/*; do b=$(basename $d)
  case $b in logs|queue|stats|backup|framework|tmp|var|api|wodles) mkdir -p $W/$b; chown --reference=$d $W/$b; chmod --reference=$d $W/$b ;;
  *) cp -a $d $W/ ;; esac
done
cp -a /var/ossec/logs/. $W/logs/ 2>/dev/null; : > $W/logs/ossec.log 2>/dev/null
for q in sockets alerts db diff fts rids; do mkdir -p $W/queue/$q; chown root:wazuh $W/queue/$q; chmod 770 $W/queue/$q; done
mkdir -p $W/var/run; chown root:wazuh $W/var/run; chmod 770 $W/var/run
for f in $SRC/chp_*rules*.xml; do install -m 640 -o root -g wazuh $f $W/etc/rules/$(basename $f); done
for f in $SRC/chp_*decoders*.xml; do [ -e "$f" ] && install -m 640 -o root -g wazuh $f $W/etc/decoders/$(basename $f); done
mount --bind $W /var/ossec
/var/ossec/bin/wazuh-analysisd -t; echo "MODE=$MODE analysisd -t rc=$?"
n=0
while IFS= read -r line; do n=$((n+1))
  echo "== MODE=$MODE line $n: ${line:0:260}"
  printf '%s\n' "$line" | timeout 60 /var/ossec/bin/wazuh-logtest-legacy 2>&1 | grep -E "Rule id|Level|Description|decoder|program_name|^ *(user|event|kind|failed|doc|path):|^\*\*Alert|No decoder" | sed 's/^/   /'
done < $SRC/lines.txt
umount /var/ossec; rm -rf $W
---- run.sh ----
#!/bin/bash
# run on aero: MODE=real (files as chp-site writes them, analysisd -t) then MODE=stdin (NC rules' location = stdin)
set -u
S=/var/tmp/chp-lt-t9
sha256sum $S/*.xml $S/lines.txt /var/tmp/chp-lt.sh
mkdir -p $S/real $S/stdin
cp $S/chp_*.xml $S/real/; : > $S/real/lines.txt
cp $S/chp_*.xml $S/stdin/; cp $S/stdin_nc.xml $S/stdin/chp_nextcloud_rules.xml; cp $S/lines.txt $S/stdin/
unshare -m --propagation private bash /var/tmp/chp-lt.sh $S/real real
unshare -m --propagation private bash /var/tmp/chp-lt.sh $S/stdin stdin
