#!/bin/bash
# Plan 3 Task 1 (I1, I2): wazuh-logtest-legacy (wazuh-manager 4.14.7 on aero, live install UNTOUCHED) inside a private
# mount namespace over a throwaway copy of /var/ossec holding the generated chp rule files. MODE=real: the files as
# chp-site writes them (analysisd -t only). MODE=stdin: the same, but chp_nextcloud_rules.xml with its <location>
# set to "stdin" (the location wazuh-logtest-legacy gives every line; the only change). Copy removed afterwards.
set -u
W=/var/tmp/wz-lt.$$; SRC=$1; MODE=$2
mkdir -p $W
for d in /var/ossec/*; do b=$(basename $d)
  case $b in logs|queue|stats|backup|framework|tmp|var|api|wodles) mkdir -p $W/$b; chown --reference=$d $W/$b; chmod --reference=$d $W/$b ;;
  *) cp -a $d $W/ ;; esac
done
cp -a /var/ossec/logs/. $W/logs/ 2>/dev/null; : > $W/logs/ossec.log 2>/dev/null
for q in sockets alerts db diff fts rids; do mkdir -p $W/queue/$q; chown root:wazuh $W/queue/$q; chmod 770 $W/queue/$q; done
mkdir -p $W/var/run; chown root:wazuh $W/var/run; chmod 770 $W/var/run
for f in chp_yara_rules.xml chp_suricata_rules.xml chp_review_rules.xml chp_nextcloud_rules.xml chp_nextcloud_rules_canary.xml; do
  install -m 640 -o root -g wazuh $SRC/$f $W/etc/rules/$f; done
[ "$MODE" = stdin ] && install -m 640 -o root -g wazuh $SRC/chp_nextcloud_rules_stdin.xml $W/etc/rules/chp_nextcloud_rules.xml
mount --bind $W /var/ossec
/var/ossec/bin/wazuh-analysisd -t; echo "MODE=$MODE analysisd -t rc=$?"
if [ "$MODE" = stdin ]; then
n=0
while IFS= read -r line; do n=$((n+1))
  echo "== MODE=$MODE line $n: ${line:0:300}"
  printf '%s\n' "$line" | timeout 60 /var/ossec/bin/wazuh-logtest-legacy 2>&1 | grep -E "Rule id|Level|Description|decoder|^ *(url|user|dstuser|srcuser):|^\*\*Alert" | sed 's/^/   /'
done < $SRC/lines.txt
fi
umount /var/ossec; rm -rf $W
