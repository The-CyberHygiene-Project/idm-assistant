postinstall scriptlet (using /bin/sh):
if [ $1 -eq 1 ] && [ -x "/usr/lib/systemd/systemd-update-helper" ]; then 
    # Initial installation 
    /usr/lib/systemd/systemd-update-helper install-system-units chp-nextcloud-egress.service nextcloud-cron.timer chp-nextcloud-backup.timer chp-nextcloud-cert-renew.timer chp-documents-check.timer || : 
fi 
systemctl daemon-reload >/dev/null 2>&1 || :
# the fapolicyd rule takes effect at the next rules load / fapolicyd restart (chp-site documents enable restarts it
# and reads fapolicyd-cli --check-status)
if [ -x /usr/sbin/fagenrules ]; then /usr/sbin/fagenrules --load >/dev/null 2>&1 || :; fi
preuninstall scriptlet (using /bin/sh):
if [ $1 -eq 0 ] && [ -x "/usr/lib/systemd/systemd-update-helper" ]; then 
    # Package removal, not upgrade 
    /usr/lib/systemd/systemd-update-helper remove-system-units chp-nextcloud-egress.service nextcloud-cron.timer chp-nextcloud-backup.timer chp-nextcloud-cert-renew.timer chp-documents-check.timer || : 
fi
postuninstall scriptlet (using /bin/sh):
# on upgrade the egress table is reloaded from the (possibly new) shipped file
if [ $1 -ge 1 ] && [ -x "/usr/lib/systemd/systemd-update-helper" ]; then 
    # Package upgrade, not uninstall 
    /usr/lib/systemd/systemd-update-helper mark-restart-system-units chp-nextcloud-egress.service || : 
fi 
