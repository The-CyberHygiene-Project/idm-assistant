# chp-build: the dedicated RPM build VM on aero (lab/build-vm/README.md). Use: ssh -F lab/build-vm/ssh_config chp-build
Host aero
    HostName 192.168.100.1
    User itadmin
    IdentityFile ~/.ssh/aero_ecdsa
    IdentitiesOnly yes
Host chp-build
    HostName 192.168.100.60
    User builder
    ProxyJump aero
    IdentityFile ~/idm-lab-secrets/chp_build_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
