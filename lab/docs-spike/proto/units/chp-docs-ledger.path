# SPIKE (Task 2, ledger route L1): run the root-owned appender whenever the chp_ledger app drops a request.
# logs/56: the default limits stopped the appender for good after six requests in ten seconds; fix 5: finite but high
# limits (the appender quarantines bad requests, so the spool always empties).
[Unit]
Description=CHP docs approval ledger: a request is waiting (spike)

[Path]
PathExistsGlob=/var/lib/chp-docs/spool/*.json
TriggerLimitIntervalSec=60
TriggerLimitBurst=300

[Install]
WantedBy=paths.target
