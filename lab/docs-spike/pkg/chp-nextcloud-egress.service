[Unit]
Description=CHP: NextCloud (the apache user) may reach only this server (SPIKE)
After=firewalld.service
Before=php-fpm.service httpd.service nextcloud-cron.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables/chp-nextcloud-egress.nft
ExecStop=/usr/sbin/nft delete table inet chp_nextcloud_egress
[Install]
WantedBy=multi-user.target
